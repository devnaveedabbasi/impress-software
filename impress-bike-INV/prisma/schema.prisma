generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  token    String?

  roleId      Int
  role        Role             @relation(fields: [roleId], references: [id])
  permissions UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

// Administrators live in their own table. A SUPER_ADMIN always has every permission; an ADMIN only has the
// permissions a super admin gave it (AdminPermission).
model Admin {
  id       Int       @id @default(autoincrement())
  name     String
  email    String    @unique
  password String
  token    String?
  role     AdminRole @default(ADMIN)
  isSystem Boolean   @default(false)

  permissions AdminPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminPermission {
  adminId      Int
  permissionId Int

  admin      Admin      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([adminId, permissionId])
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id        Int              @id @default(autoincrement())
  name      String
  operation String
  roles     RolePermission[]
  users     UserPermission[]
  admins    AdminPermission[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([operation, name])
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       Int
  permissionId Int

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

// Opreation
// 01- Account code management

enum AccountCodeGroup {
  expenses
  currentassets
  liabilities
  capital
  revenue
  purchases
  otherIncomeAndExpense
  Expense
}

model AccountCode {
  id       Int              @id @default(autoincrement())
  headName String
  group    AccountCodeGroup

  code           String[]
  name           String[]
  address        String[]
  contactNo      String[]
  saleTaxNo      String[]
  openingBalance Int[]

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Operation
// 02 - Province Management

model Province {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cities      City[]
  dealers     Dealer[]
  vendors     Vendor[]
}

// 03 - City Management

model City {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  province    Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  provinceId  Int
  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dealers     Dealer[]
  vendors     Vendor[]
}

enum DealerType {
  single
  dealar
}

// 04 Dealer Management
model Dealer {
  id             Int    @id @default(autoincrement())
  // Delar Info
  dealarShipName String
  contactNo      String
  address        String
  saleTaxNo      String
  NTNNo          String

  // info
  name            String
  provinceId      Int
  cityId          Int
  province        Province   @relation(fields: [provinceId], references: [id])
  city            City       @relation(fields: [cityId], references: [id])
  mobileNo        String
  opeaningBalance Int
  dealarType      DealerType
  NICNo           String

  rejectionReceipts RejectionReceivedFromDealer[]

  createdById Int
  updatedById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 05 Vendor Manegment
model Vendor {
  id         Int      @id @default(autoincrement())
  vendorName String
  address    String
  saleTaxNo  String
  cityId     Int
  provinceId Int
  province   Province @relation(fields: [provinceId], references: [id])
  city       City     @relation(fields: [cityId], references: [id])
  contactNo  String

  // Info
  NICNo          String
  mobileNo       String
  daysLimit      Int
  NTNNo          String
  CNICNo         String
  amoutLimit     Int
  openingBalance Int

  createdById      Int
  updatedById      Int
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  quotations       Quotation[]
  purchaseOrders   PurchaseOrder[]
  rejectionReturns RejectionReturnToVendor[]
}

// 07 Category Manegment
model Category {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  createdById Int?
  updatedById Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  inventories Inventory[]
}

// 08 Department Manegment
model Department {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  createdById Int?
  updatedById Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  inventories Inventory[]
  storeIssues StoreIssue[]
  itemReturns ItemReturn[]
}

// 09 Station Manegment
model Station {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  createdById     Int?
  updatedById     Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  inventoryStocks InventoryStock[]
}

// 09.1 Color Management (master entry used by inventory stock rows)
model Color {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  createdById     Int?
  updatedById     Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  inventoryStocks InventoryStock[]
  storeIssues     StoreIssue[]
}

// 06 Inventory  Manegment
model Inventory {
  id         Int      @id @default(autoincrement())
  itemName   String
  pack       Int
  rate       Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  stationIds Int[]

  color       String[]
  qty         Int[]
  unitPerBike Int

  createdById          Int?
  updatedById          Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  saleGatePassItems    SaleGatePassItem[]
  rejectionReturnItems RejectionReturnItem[]
  rejectionReceivedItems RejectionReceivedItem[]
  stockTransfersIn       StockTransfer[]
  stockTransferItems     StockTransferItem[]
  inwardItems          InwardItem[]
  stocks               InventoryStock[]
  storeIssueItems      StoreIssueItem[]
  itemReturnItems      ItemReturnItem[]
  stockMovements       StockMovement[]
}

// 06.1 Inventory stock rows — one row per (station, color) with its quantity
model InventoryStock {
  id          Int       @id @default(autoincrement())
  inventoryId Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  stationId   Int
  station     Station   @relation(fields: [stationId], references: [id])
  colorId     Int
  color       Color     @relation(fields: [colorId], references: [id])
  qty         Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inventoryId, stationId, colorId])
  @@index([colorId])
  @@index([stationId])
}

model Quotation {
  id       Int      @id @default(autoincrement())
  date     DateTime
  vendorId Int
  vendor   Vendor   @relation(fields: [vendorId], references: [id])
  remarks  String

  itemName     String[]
  oldRate      Int[]
  proposedRate Int[]
  approvedRate Int[]

  createdById    Int?
  updatedById    Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
  inwards        Inward[]
}

model PurchaseOrder {
  id          Int       @id @default(autoincrement())
  date        DateTime
  vendorId    Int
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  validity    String
  instruction String
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id])

  code     Int[]
  itemName String[]
  unit     Int[]
  quantity Int[]
  rate     Int[]
  amount   Int[]

  total              Int
  saleTaxPercent     Int
  totalWithSaleTax   Int
  withHoldingPercent Int
  withHoldingAmount  Int
  grandTotal         Int

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  inwards     Inward[]
}

enum InwardType {
  againstSimple
  againstPO
  againstDealarRejection
}

// 10 Inward/Quality Controll
model Inward {
  id              Int            @id @default(autoincrement())
  date            DateTime
  Type            InwardType
  purchaseOrderId Int?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  quotationId     Int?
  quotation       Quotation?     @relation(fields: [quotationId], references: [id])
  GRIRNo          Int
  DCNo            Int
  billNO          Int?
  detail          String

  items InwardItem[]

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 10.1 Inward/Quality Control item rows — each row is linked to an Inventory item
model InwardItem {
  id            Int       @id @default(autoincrement())
  inwardId      Int
  inward        Inward    @relation(fields: [inwardId], references: [id], onDelete: Cascade)
  inventoryId   Int
  inventory     Inventory @relation(fields: [inventoryId], references: [id])
  poBalQty      Int       @default(0)
  recQty        Int       @default(0)
  rejQty        Int       @default(0)
  okQty         Int       @default(0)
  packingDetail String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inwardId, inventoryId])
  @@index([inventoryId])
}

// 11 Sale GatePass

model SaleGatePass {
  id          Int      @id @default(autoincrement())
  date        DateTime
  accountName String
  billNO      Int?
  throughBy   String   @default("")
  remarks     String   @default("")
  vehicleNo   String   @default("")

  items SaleGatePassItem[]

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 11.1 Sale GatePass item rows — each row is linked to an Inventory item
model SaleGatePassItem {
  id             Int          @id @default(autoincrement())
  saleGatePassId Int
  saleGatePass   SaleGatePass @relation(fields: [saleGatePassId], references: [id], onDelete: Cascade)
  inventoryId    Int
  inventory      Inventory    @relation(fields: [inventoryId], references: [id])
  unit           String       @default("")
  // Stock of the item at the time the gate pass was issued (may be negative, like the old system)
  stockInHand    Int          @default(0)
  qty            Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([saleGatePassId, inventoryId])
  @@index([inventoryId])
}

// 12 RejectionReturnTo Vendor
// "id" is the Claim Note No of the gate pass (generated automatically)
model RejectionReturnToVendor {
  id         Int      @id @default(autoincrement())
  date       DateTime
  vendorId   Int
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  address    String
  contactNo  String
  saleTaxNo  String
  transport  String
  builtyNo   String   @default("")
  bookNo     String   @default("")
  receivedBy String

  items RejectionReturnItem[]

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vendorId])
}

// 12.1 Rejection Return item rows — each row is linked to an Inventory item
model RejectionReturnItem {
  id                Int                     @id @default(autoincrement())
  rejectionReturnId Int
  rejectionReturn   RejectionReturnToVendor @relation(fields: [rejectionReturnId], references: [id], onDelete: Cascade)
  inventoryId       Int
  inventory         Inventory               @relation(fields: [inventoryId], references: [id])
  rej               Int
  report            String                  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rejectionReturnId, inventoryId])
  @@index([inventoryId])
}

// 12.2 Rejection Received from Dealer: rejected parts that a dealer sends back to us.
// Same as "Rejection Return to Vendor" but with a dealer. "id" is the Claim Note No (generated automatically)
model RejectionReceivedFromDealer {
  id         Int      @id @default(autoincrement())
  date       DateTime
  dealerId   Int
  dealer     Dealer   @relation(fields: [dealerId], references: [id])
  address    String
  contactNo  String
  saleTaxNo  String
  transport  String
  builtyNo   String   @default("")
  bookNo     String   @default("")
  receivedBy String

  items RejectionReceivedItem[]

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dealerId])
}

// 12.3 Rejection Received item rows: each row is linked to an Inventory item
model RejectionReceivedItem {
  id                  Int                         @id @default(autoincrement())
  rejectionReceivedId Int
  rejectionReceived   RejectionReceivedFromDealer @relation(fields: [rejectionReceivedId], references: [id], onDelete: Cascade)
  inventoryId         Int
  inventory           Inventory                   @relation(fields: [inventoryId], references: [id])
  rej                 Int
  report              String                      @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rejectionReceivedId, inventoryId])
  @@index([inventoryId])
}

// 14 Transfer Form: the stock of old item(s) moves to a new item (new code / new name).
// "id" is the Trans ID (generated automatically). "qty" is the total moved = the total of the old rows.
model StockTransfer {
  id             Int       @id @default(autoincrement())
  date           DateTime
  newInventoryId Int
  newInventory   Inventory @relation(fields: [newInventoryId], references: [id])
  qty            Int

  items StockTransferItem[]

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([newInventoryId])
}

// 14.1 Transfer rows: the OLD items whose stock is moved
model StockTransferItem {
  id              Int           @id @default(autoincrement())
  stockTransferId Int
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  inventoryId     Int
  inventory       Inventory     @relation(fields: [inventoryId], references: [id])
  qty             Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stockTransferId, inventoryId])
  @@index([inventoryId])
}

// 13 Store Issuance ("Issue from Line"): parts issued from the store to a department for N bikes of a color.
// "id" is the Requisition Slip No (generated automatically).
model StoreIssue {
  id           Int        @id @default(autoincrement())
  date         DateTime
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  colorId      Int
  color        Color      @relation(fields: [colorId], references: [id])
  bikeQty      Int

  items StoreIssueItem[]

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([departmentId])
  @@index([colorId])
}

// 13.1 Store Issuance item rows — each row is linked to an Inventory item
model StoreIssueItem {
  id           Int        @id @default(autoincrement())
  storeIssueId Int
  storeIssue   StoreIssue @relation(fields: [storeIssueId], references: [id], onDelete: Cascade)
  inventoryId  Int
  inventory    Inventory  @relation(fields: [inventoryId], references: [id])
  // Units of this item that one bike needs (Upm), taken from the inventory when the slip is issued
  upm          Int        @default(0)
  // Stock of the item at the time the slip was issued (may be negative)
  handStock    Int        @default(0)
  issueQty     Int
  purpose      String     @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeIssueId, inventoryId])
  @@index([inventoryId])
}

// 14 Item Return from Department ("Rejection Received"): parts a department gives back to the store.
// "id" is the Requisition Slip No (generated automatically).
model ItemReturn {
  id           Int        @id @default(autoincrement())
  date         DateTime
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  items ItemReturnItem[]

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([departmentId])
}

// 14.1 Item Return item rows — each row is linked to an Inventory item
model ItemReturnItem {
  id           Int        @id @default(autoincrement())
  itemReturnId Int
  itemReturn   ItemReturn @relation(fields: [itemReturnId], references: [id], onDelete: Cascade)
  inventoryId  Int
  inventory    Inventory  @relation(fields: [inventoryId], references: [id])
  recvdQty     Int
  purpose      String     @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemReturnId, inventoryId])
  @@index([inventoryId])
}

// 15 Stock Movement ledger: every document that moves stock writes its lines here (+ in, - out).
// Stock in hand = the stock of the Inventory master + the total of these movements.
// The id is a cuid (not a counter) so rows made on LOCAL and on LIVE can never clash when they are synced.
model StockMovement {
  id          String    @id @default(cuid())
  date        DateTime
  inventoryId Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  qty         Int
  sourceType  String // INWARD | SALE_GATE_PASS | STORE_ISSUE | ITEM_RETURN
  sourceId    Int
  note        String    @default("")
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([inventoryId, date])
  @@index([sourceType, sourceId])
}

